    "load_financial_data": {
        "skill_name": "Load Financial Data",
        "node_type": "base",
        "operator_class": "MultiTableBaseOperator",
        "keywords": [
            "Load",
            "Income",
            "Expenses",
            "Tax"
        ],
        "ports": {
            "requires": [],
            "provides": [
                "Financial:IncomeTxnID",
                "Financial:IncomeSource",
                "Financial:IncomeCountry",
                "Financial:RawIncome",
                "Financial:ExpID",
                "Financial:ExpSource",
                "Financial:ExpDesc",
                "Financial:RawExpenses",
                "Financial:TaxCountry",
                "Financial:RawTaxInfo"
            ]
        },
        "possible_successors": [
            {
                "skill_id": "inject_missing_revenue",
                "port_map": {
                    "Financial:RawIncome": "Financial:RawIncome"
                }
            },
            {
                "skill_id": "map_tax_rates",
                "port_map": {
                    "Financial:RawTaxInfo": "Financial:RawTaxInfo"
                }
            },
            {
                "skill_id": "categorize_expenses",
                "port_map": {
                    "Financial:RawExpenses": "Financial:RawExpenses"
                }
            }
        ],
        "semantics": {
            "intents": [
                "Load the raw income, costs, and tax withholding data from multiple sources ({sources}).",
                "Export the loaded raw datasets to {deliverable_file}."
            ],
            "deliverables": [
                "raw_financials.xlsx"
            ],
            "rubrics": [
                "The final deliverable is successfully generated and named '{deliverable_file}'.",
                "Verify that the final deliverable contains consolidated financial data originating from all specified {sources}."
            ]
        },
        "data_params": {
            "sources": [
                "Tour Manager",
                "Production Company"
            ],
            "deliverable_file": "raw_financials.xlsx",
            "suggested_row_counts": {
                "income.xlsx": 150,
                "expenses.xlsx": 300,
                "tax_info.xlsx": 4
            },
            "schemas": {
                "income.xlsx": [
                    {
                        "name": "Txn_ID",
                        "generator_type": "id"
                    },
                    {
                        "name": "Source",
                        "generator_type": "categorical",
                        "kwargs": {
                            "categories": [
                                "Tour Manager",
                                "Production Company"
                            ]
                        }
                    },
                    {
                        "name": "Country",
                        "generator_type": "categorical",
                        "kwargs": {
                            "categories": [
                                "UK",
                                "France",
                                "Spain",
                                "Germany"
                            ]
                        }
                    },
                    {
                        "name": "Gross Revenue",
                        "generator_type": "uniform",
                        "kwargs": {
                            "min": 5000,
                            "max": 100000
                        }
                    }
                ],
                "expenses.xlsx": [
                    {
                        "name": "Exp_ID",
                        "generator_type": "id"
                    },
                    {
                        "name": "Source",
                        "generator_type": "categorical",
                        "kwargs": {
                            "categories": [
                                "Tour Manager",
                                "Production Company"
                            ]
                        }
                    },
                    {
                        "name": "Expense_Desc",
                        "generator_type": "categorical",
                        "kwargs": {
                            "categories": [
                                "Flights",
                                "Hotels",
                                "Crew Wages",
                                "Catering"
                            ]
                        }
                    },
                    {
                        "name": "Amount",
                        "generator_type": "uniform",
                        "kwargs": {
                            "min": 500,
                            "max": 20000
                        }
                    }
                ],
                "tax_info.xlsx": [
                    {
                        "name": "Country",
                        "generator_type": "categorical",
                        "kwargs": {
                            "categories": [
                                "UK",
                                "France",
                                "Spain",
                                "Germany"
                            ]
                        }
                    },
                    {
                        "name": "Tax_Rate",
                        "generator_type": "uniform",
                        "kwargs": {
                            "min": 0.15,
                            "max": 0.25
                        }
                    }
                ]
            },
            "port_to_column_mapping": {
                "Financial:IncomeTxnID": {
                    "table": "income.xlsx",
                    "column": "Txn_ID"
                },
                "Financial:IncomeSource": {
                    "table": "income.xlsx",
                    "column": "Source"
                },
                "Financial:IncomeCountry": {
                    "table": "income.xlsx",
                    "column": "Country"
                },
                "Financial:RawIncome": {
                    "table": "income.xlsx",
                    "column": "Gross Revenue"
                },
                "Financial:ExpID": {
                    "table": "expenses.xlsx",
                    "column": "Exp_ID"
                },
                "Financial:ExpSource": {
                    "table": "expenses.xlsx",
                    "column": "Source"
                },
                "Financial:ExpDesc": {
                    "table": "expenses.xlsx",
                    "column": "Expense_Desc"
                },
                "Financial:RawExpenses": {
                    "table": "expenses.xlsx",
                    "column": "Amount"
                },
                "Financial:TaxCountry": {
                    "table": "tax_info.xlsx",
                    "column": "Country"
                },
                "Financial:RawTaxInfo": {
                    "table": "tax_info.xlsx",
                    "column": "Tax_Rate"
                }
            }
        }
    },
    "inject_missing_revenue": {
        "skill_name": "Inject Missing Revenue",
        "node_type": "trap",
        "operator_class": "CellPerturbationOperator",
        "keywords": [
            "Inject",
            "Null",
            "Missing",
            "Anomalies"
        ],
        "ports": {
            "requires": [
                "Financial:RawIncome"
            ],
            "provides": [
                "Financial:IncomeWithAnomalies"
            ]
        },
        "possible_successors": [
            {
                "skill_id": "handle_missing_revenue",
                "port_map": {
                    "Financial:IncomeWithAnomalies": "Financial:IncomeWithAnomalies"
                }
            }
        ],
        "semantics": {
            "intents": [
                "Inject null or missing values into the {target_column} field within the income dataset to simulate incomplete data."
            ],
            "rubrics": [
                "In accordance with industry standards for financial reporting, verify that the final deliverable gracefully handles the {trap_count} missing or null values introduced during processing, ensuring they are either imputed, flagged, or excluded without causing downstream calculation errors."
            ]
        },
        "data_params": {
            "perturbation_mode": "to_null",
            "trap_count": 5
        }
    },
    "handle_missing_revenue": {
        "skill_name": "Handle Missing Revenue",
        "node_type": "mutate",
        "operator_class": "PhantomTaskOperator",
        "keywords": [
            "Identify",
            "Handle",
            "Missing",
            "Completeness"
        ],
        "ports": {
            "requires": [
                "Financial:IncomeWithAnomalies"
            ],
            "provides": [
                "Financial:CleanedIncome"
            ]
        },
        "possible_successors": [
            {
                "skill_id": "map_tax_rates",
                "port_map": {
                    "Financial:CleanedIncome": "Financial:CleanedIncome"
                }
            }
        ],
        "semantics": {
            "intents": [
                "Identify and handle missing or null values in the {target_column} field to ensure data completeness."
            ],
            "rubrics": [
                "Verify that the final deliverable contains no unhandled null or missing values in the '{target_column}' field.",
                "Any rows originally containing missing data in '{target_column}' are handled gracefully, ensuring that aggregate totals do not result in #DIV/0!, #VALUE!, or infinite errors."
            ]
        },
        "data_params": {
            "target_column": "Gross Revenue"
        }
    },
    "map_tax_rates": {
        "skill_name": "Map Tax Rates",
        "node_type": "mutate",
        "operator_class": "PhantomTaskOperator",
        "keywords": [
            "Map",
            "Tax Rates",
            "Country"
        ],
        "ports": {
            "requires": [
                "Financial:CleanedIncome",
                "Financial:RawTaxInfo"
            ],
            "provides": [
                "Financial:IncomeWithTaxRates"
            ]
        },
        "possible_successors": [
            {
                "skill_id": "calculate_tax_withholding",
                "port_map": {
                    "Financial:IncomeWithTaxRates": "Financial:IncomeWithTaxRates"
                }
            }
        ],
        "semantics": {
            "intents": [
                "Map tax withholding rates to each tour stop based on {country_column} using the following rates: {tax_rates}."
            ],
            "rubrics": [
                "The final deliverable includes a mapping or calculation that correctly associates the '{country_column}' with its respective tax rate.",
                "If tax rates are explicitly listed in the final deliverable, they accurately reflect the provided {tax_rates} mapping for each corresponding '{country_column}'."
            ]
        },
        "data_params": {
            "country_column": "Country",
            "tax_rates": {
                "UK": "20%",
                "France": "15%",
                "Spain": "24%",
                "Germany": "15.825%"
            }
        }
    },
    "calculate_tax_withholding": {
        "skill_name": "Calculate Tax Withholding",
        "node_type": "mutate",
        "operator_class": "PhantomTaskOperator",
        "keywords": [
            "Calculate",
            "Tax Withholding",
            "Amount"
        ],
        "ports": {
            "requires": [
                "Financial:IncomeWithTaxRates"
            ],
            "provides": [
                "Financial:TaxWithholding"
            ]
        },
        "possible_successors": [
            {
                "skill_id": "calculate_net_revenue_local",
                "port_map": {
                    "Financial:TaxWithholding": "Financial:TaxWithholding"
                }
            }
        ],
        "semantics": {
            "intents": [
                "Calculate the tax withholding amount for each line item based on the mapped rates and {revenue_column}."
            ],
            "rubrics": [
                "The tax withholding amount in the final deliverable is mathematically accurate, computed as the product of the mapped tax rate and the '{revenue_column}'."
            ]
        },
        "data_params": {
            "revenue_column": "Gross Revenue"
        }
    },
    "calculate_net_revenue_local": {
        "skill_name": "Calculate Net Revenue Local",
        "node_type": "mutate",
        "operator_class": "PhantomTaskOperator",
        "keywords": [
            "Calculate",
            "Net Revenue",
            "Subtract"
        ],
        "ports": {
            "requires": [
                "Financial:TaxWithholding"
            ],
            "provides": [
                "Financial:NetRevenueLocal"
            ]
        },
        "possible_successors": [
            {
                "skill_id": "convert_revenue_usd",
                "port_map": {
                    "Financial:NetRevenueLocal": "Financial:NetRevenueLocal"
                }
            }
        ],
        "semantics": {
            "intents": [
                "Calculate {target_metric} for each tour stop by subtracting the tax withholding amount from the {revenue_column}."
            ],
            "rubrics": [
                "The final deliverable contains a metric or column representing '{target_metric}'.",
                "The '{target_metric}' is correctly computed as the '{revenue_column}' minus the calculated tax withholding amount."
            ]
        },
        "data_params": {
            "target_metric": "Net Revenue",
            "revenue_column": "Gross Revenue"
        }
    },
